{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Listen for XDebug",
      "type": "php",
      "request": "launch",
      "port": 9000,
      "pathMappings": {
        "/var/www/html": "${workspaceRoot}/wordpress",
        "/var/www/html/wp-content/themes":"${workspaceRoot}/wp-content/themes",
        "/var/www/html/wp-content/plugins":"${workspaceRoot}/wp-content/plugins",
        "/var/www/html/wp-content/uploads":"${workspaceRoot}/wp-content/uploads"
      }
    }
  ]
}
